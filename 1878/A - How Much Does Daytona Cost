#include <bits/stdc++.h>
using namespace std;
 
int main() {
    int t;
    cin>>t;
    
    while(t--) {
        int n , k;
        cin>>n>>k;
        vector<int> v;
        
        for(int i = 0 ; i < n ; i++) {
            int x;
            cin>>x;
            v.push_back(x);
        }
        
        unordered_map<int,int> mp;
        
        for(int i = 0 ; i < n ; i++) {
            mp[v[i]]++;
        }
        
        bool present = false;
        for(auto it : mp) {
            if(it.first == k) {
                present = true;
                cout<<"YES
";
                break;
            } else {
                continue;
            }
        }
        
        if(present == false) cout<<"NO
";
    }
}